<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Trực quan hóa thuật toán Shell Sort</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Georgia', serif;
            background: linear-gradient(135deg, #1a1a1a 0%, #2d2d2d 100%);
            color: #d4af37;
            min-height: 100vh;
            padding: 20px;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
        }

        h1 {
            text-align: center;
            font-size: 3.5em;
            margin-bottom: 50px;
            text-shadow: 2px 2px 4px rgba(0,0,0,0.5);
            letter-spacing: 2px;
        }

        .controls {
            display: flex;
            justify-content: center;
            gap: 15px;
            margin-bottom: 40px;
            flex-wrap: wrap;
        }

        button {
            background: linear-gradient(135deg, #d4af37 0%, #f4d03f 100%);
            color: #1a1a1a;
            border: none;
            padding: 12px 30px;
            font-size: 1.1em;
            font-weight: bold;
            border-radius: 8px;
            cursor: pointer;
            transition: all 0.3s ease;
            box-shadow: 0 4px 15px rgba(212, 175, 55, 0.3);
        }

        button:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(212, 175, 55, 0.5);
        }

        button:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }

        .phases {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
            gap: 25px;
            margin-bottom: 40px;
        }

        .phase-card {
            background: rgba(212, 175, 55, 0.1);
            border: 2px solid #d4af37;
            border-radius: 15px;
            padding: 25px;
            transition: all 0.3s ease;
        }

        .phase-card.active {
            background: rgba(212, 175, 55, 0.25);
            box-shadow: 0 0 30px rgba(212, 175, 55, 0.4);
            transform: scale(1.02);
        }

        .phase-card h2 {
            font-size: 1.8em;
            margin-bottom: 15px;
            color: #f4d03f;
        }

        .phase-card h3 {
            font-size: 1.3em;
            margin-bottom: 10px;
            color: #d4af37;
        }

        .phase-card p {
            font-size: 1.1em;
            line-height: 1.6;
            color: #e6d19a;
        }

        .visualization {
            background: rgba(0, 0, 0, 0.3);
            border: 2px solid #d4af37;
            border-radius: 15px;
            padding: 40px;
            margin-top: 30px;
        }

        .array-container {
            display: flex;
            justify-content: center;
            align-items: flex-end;
            gap: 8px;
            margin: 30px 0;
            min-height: 250px;
        }

        .array-bar {
            width: 50px;
            background: linear-gradient(180deg, #f4d03f 0%, #d4af37 100%);
            border-radius: 5px 5px 0 0;
            position: relative;
            transition: all 0.4s ease;
            display: flex;
            align-items: flex-end;
            justify-content: center;
            padding-bottom: 5px;
            box-shadow: 0 4px 10px rgba(212, 175, 55, 0.3);
        }

        .array-bar.comparing {
            background: linear-gradient(180deg, #ff6b6b 0%, #ee5a6f 100%);
            transform: translateY(-10px);
        }

        .array-bar.swapping {
            background: linear-gradient(180deg, #4ecdc4 0%, #44a08d 100%);
            transform: scale(1.1);
        }

        .array-bar.sorted {
            background: linear-gradient(180deg, #95e1d3 0%, #5ebc82 100%);
        }

        .bar-value {
            color: #1a1a1a;
            font-weight: bold;
            font-size: 1.1em;
        }

        .info {
            text-align: center;
            margin-top: 30px;
            font-size: 1.3em;
            color: #f4d03f;
            min-height: 40px;
            font-weight: bold;
        }

        .gap-info {
            text-align: center;
            margin: 20px 0;
            font-size: 1.5em;
            color: #d4af37;
        }

        @keyframes pulse {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.6; }
        }

        .phase-card.active h2 {
            animation: pulse 1.5s infinite;
        }
    </style>
</head>
<body>
    <div class="container">
        <h1>Trực quan hóa thuật toán Shell Sort</h1>

        <div class="controls">
            <button onclick="resetArray()">Tạo Mảng Mới</button>
            <button onclick="startSort()" id="startBtn">Bắt Đầu Sắp Xếp</button>
            <button onclick="pauseSort()" id="pauseBtn" disabled>Tạm Dừng</button>
            <button onclick="resumeSort()" id="resumeBtn" disabled>Tiếp Tục</button>
        </div>

        <div class="phases">
            <div class="phase-card" id="phase1">
                <h2>Giai đoạn 1</h2>
                <h3>Chia nhóm theo gap</h3>
                <p>Tạo cấu trúc "bộ khung gần đúng" cho mảng</p>
            </div>

            <div class="phase-card" id="phase2">
                <h2>Giai đoạn 2</h2>
                <h3>Sắp xếp cục bộ</h3>
                <p>Phân từ bất đầu tiến gần đúng vị trí toán cực</p>
            </div>

            <div class="phase-card" id="phase3">
                <h2>Giai đoạn 3</h2>
                <h3>Hoàn thiện (gap=1)</h3>
                <p>Mảng gần hoàn hảo, chỉ cần vài bước chèn cuối</p>
            </div>
        </div>

        <div class="visualization">
            <div class="gap-info" id="gapInfo">Khởi tạo mảng...</div>
            <div class="array-container" id="arrayContainer"></div>
            <div class="info" id="info">Nhấn "Bắt Đầu Sắp Xếp" để bắt đầu</div>
        </div>
    </div>

    <script>
        let array = [];
        let sorting = false;
        let paused = false;
        let currentPhase = 0;

        function resetArray() {
            array = [];
            for (let i = 0; i < 10; i++) {
                array.push(Math.floor(Math.random() * 90) + 10);
            }
            renderArray();
            document.getElementById('info').textContent = 'Nhấn "Bắt Đầu Sắp Xếp" để bắt đầu';
            document.getElementById('gapInfo').textContent = 'Mảng đã được tạo';
            setPhase(0);
            sorting = false;
            paused = false;
            updateButtons();
        }

        function renderArray(comparing = [], swapping = [], sorted = []) {
            const container = document.getElementById('arrayContainer');
            container.innerHTML = '';

            const maxValue = Math.max(...array);

            array.forEach((value, idx) => {
                const bar = document.createElement('div');
                bar.className = 'array-bar';
                bar.style.height = `${(value / maxValue) * 200}px`;

                if (comparing.includes(idx)) {
                    bar.classList.add('comparing');
                }
                if (swapping.includes(idx)) {
                    bar.classList.add('swapping');
                }
                if (sorted.includes(idx)) {
                    bar.classList.add('sorted');
                }

                const valueLabel = document.createElement('span');
                valueLabel.className = 'bar-value';
                valueLabel.textContent = value;
                bar.appendChild(valueLabel);

                container.appendChild(bar);
            });
        }

        function setPhase(phase) {
            for (let i = 1; i <= 3; i++) {
                document.getElementById(`phase${i}`).classList.remove('active');
            }
            if (phase > 0) {
                document.getElementById(`phase${phase}`).classList.add('active');
            }
            currentPhase = phase;
        }

        function sleep(ms) {
            return new Promise(resolve => {
                const checkPause = setInterval(() => {
                    if (!paused) {
                        clearInterval(checkPause);
                        setTimeout(resolve, ms);
                    }
                }, 100);
            });
        }

        async function shellSort() {
            sorting = true;
            updateButtons();

            const n = array.length;
            const gaps = [Math.floor(n / 2)];

            while (gaps[gaps.length - 1] > 1) {
                gaps.push(Math.floor(gaps[gaps.length - 1] / 2));
            }

            for (let g = 0; g < gaps.length; g++) {
                const gap = gaps[g];

                if (gap > 1) {
                    setPhase(1);
                    document.getElementById('gapInfo').textContent = `Gap hiện tại: ${gap} (Chia nhóm)`;
                    document.getElementById('info').textContent = `Chia mảng thành các nhóm với khoảng cách ${gap}`;
                } else if (gap === 1) {
                    setPhase(3);
                    document.getElementById('gapInfo').textContent = `Gap = 1 (Hoàn thiện)`;
                    document.getElementById('info').textContent = `Sắp xếp chèn cuối cùng với gap = 1`;
                } else {
                    setPhase(2);
                    document.getElementById('gapInfo').textContent = `Gap hiện tại: ${gap}`;
                }

                await sleep(800);

                for (let i = gap; i < n; i++) {
                    if (!sorting) return;

                    const temp = array[i];
                    let j = i;

                    renderArray([i], [], []);
                    await sleep(500);

                    while (j >= gap && array[j - gap] > temp) {
                        if (!sorting) return;

                        setPhase(gap === 1 ? 3 : 2);
                        document.getElementById('info').textContent = `So sánh ${array[j - gap]} và ${temp}`;
                        renderArray([j, j - gap], [], []);
                        await sleep(500);

                        array[j] = array[j - gap];
                        renderArray([], [j, j - gap], []);
                        await sleep(500);

                        j -= gap;
                    }

                    array[j] = temp;
                    renderArray();
                    await sleep(300);
                }
            }

            const sortedIndices = array.map((_, i) => i);
            renderArray([], [], sortedIndices);
            document.getElementById('info').textContent = 'Sắp xếp hoàn tất!';
            document.getElementById('gapInfo').textContent = 'Hoàn thành';
            setPhase(0);

            sorting = false;
            updateButtons();
        }

        function startSort() {
            if (!sorting) {
                shellSort();
            }
        }

        function pauseSort() {
            paused = true;
            updateButtons();
        }

        function resumeSort() {
            paused = false;
            updateButtons();
        }

        function updateButtons() {
            document.getElementById('startBtn').disabled = sorting;
            document.getElementById('pauseBtn').disabled = !sorting || paused;
            document.getElementById('resumeBtn').disabled = !sorting || !paused;
        }

        resetArray();
    </script>
</body>
</html>
